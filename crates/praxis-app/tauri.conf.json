{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Praxis Sound",
  "version": "0.1.0",
  "identifier": "com.praxissound.workstation",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../app/dist",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../app", "wait": false },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../app" }
  },
  "app": {
    "windows": [
      {
        "title": "Praxis Sound",
        "width": 1440,
        "height": 900,
        "minWidth": 380,
        "minHeight": 560,
        "backgroundColor": "#000000",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Praxis Sound",
    "copyright": "Praxis Sound. All rights reserved.",
    "category": "Music",
    "shortDescription": "Score-driven music and sound design",
    "longDescription": "Turns a text brief or a reference clip into editable, layered audio rendered from a score.",
    "resources": {
      "../../packs/index.json": "packs/index.json",
      "../../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../../LICENSE-MIT": "LICENSE-MIT",
      "../../LICENSE-APACHE": "LICENSE-APACHE"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "compression": "bzip2" }
    }
  }
}
